# ─────────────────────────────────────────────────────────────
# Voiland Finances & Patrimoine — variables d'environnement
# Copier en .env.local (non versionné) et compléter.
# ─────────────────────────────────────────────────────────────

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# ── HubSpot — côté SERVEUR uniquement (jamais préfixées NEXT_PUBLIC_) ──
# Mode « crm » : jeton d'application privée HubSpot
#   Scopes : crm.objects.contacts.write, crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=
# Mode « forms » (si pas de jeton) : soumission d'un formulaire HubSpot
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Facultatif (mode forms) : ID du type d'abonnement pour le consentement marketing
HUBSPOT_SUBSCRIPTION_TYPE_ID=
# Préfixe des propriétés personnalisées (défaut : voiland_)
HUBSPOT_PROPERTY_PREFIX=voiland_

# ── HubSpot — côté NAVIGATEUR (valeurs publiques, non secrètes) ──
# Lien de prise de rendez-vous HubSpot Meetings
NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=
# Portal ID pour le code de suivi (chargé uniquement après consentement)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Région du portail (ex. eu1) — laisser vide pour la région par défaut
NEXT_PUBLIC_HUBSPOT_REGION=

# ── Mascotte ──
# svg (défaut) | image (PNG officiel dans public/mascot/voiland-robot.png) | model (futur GLB)
NEXT_PUBLIC_MASCOT_RENDERER=svg

# ── Démonstration ──
# 1 = afficher le bandeau cookies même sans traceur configuré (à ne pas activer en production)
NEXT_PUBLIC_CONSENT_DEMO=
